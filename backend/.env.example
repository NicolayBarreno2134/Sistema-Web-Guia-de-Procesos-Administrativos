PORT=3000
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/sistema_guia_administrativos
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# SMTP para enviar los enlaces de recuperación
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Sistema Guía Administrativa <your_email@example.com>"
